# Copy to .env locally. Never commit real credentials.
GIGACHAT_AUTH_KEY=
# Alternative to Authorization Key: fill BOTH fields below.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Optional PEM certificate, relative to this directory or absolute.
GIGACHAT_CA_BUNDLE=

# Optional alternative official API endpoint if api.giga.chat is unreachable.
# GIGACHAT_CHAT_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
