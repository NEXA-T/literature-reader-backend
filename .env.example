# Copy to .env locally. Never commit real credentials.
APP_NAME=literature-reader-backend
DEBUG=true
# Backend placeholder; not yet connected to the GigaChat smoke test.
GIGACHAT_API_KEY=
# Smoke test: use Authorization Key OR both Client ID and Client Secret.
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Optional PEM certificate, relative to this directory or absolute.
GIGACHAT_CA_BUNDLE=
# Optional alternative official API endpoint if api.giga.chat is unreachable.
# GIGACHAT_CHAT_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
