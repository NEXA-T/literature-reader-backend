{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiteraryAnalysisDraft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "term": {"type":"string","minLength":1},
    "definition": {"type":"string","minLength":1},
    "explanation": {"type":"string","minLength":1},
    "examples": {"type":"array","items":{"type":"string","minLength":1},"minItems":2,"maxItems":2},
    "expression_type": {"type":"string","enum":["idiom","slang","metaphor","irony","literal","uncertain"]},
    "literal_meaning": {"type":"string","minLength":1},
    "context_evidence": {"type":"array","items":{"type":"string","minLength":1},"maxItems":3},
    "uncertainty": {"type":"string"}
  },
  "required": ["term","definition","explanation","examples","expression_type","literal_meaning","context_evidence","uncertainty"]
}
